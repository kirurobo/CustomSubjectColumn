{
  "manifest_version": 3,
  "version": "0.6.4",
  "author": "Kirurobo",
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "custom-subject-column@kirurobo.com",
      "strict_min_version": "128.0",
      "strict_max_version": "136.*"
    }
  },
  "background": {
    "persistant": false,
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "__MSG_extensionName__"
  },
  "icons": {
    "64": "icon.svg",
    "32": "icon.svg",
    "16": "icon.svg"
  },
  "options_ui": {
    "page": "options.html"
  },
  "permissions": [
    "storage"
  ],
  "experiment_apis": {
    "customSubject": {
      "schema": "schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["customSubject"]],
        "script": "implementation.js"
      }
    }
  },
  "default_locale": "en"
}
